pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }
    stages {
        stage('拉取测试脚本') {
            steps {
                checkout scm    // 把仓库完整内容（含 tests/ 目录）检出到 workspace
            }
        }
        stage('串口自动化测试') {
            steps {
                sh 'python3 tests/serial_demo.py'   // 路径相对于 workspace 根目录
            }
        }
    }
    post {
        always { echo '测试结束，详细输出见上方日志' }
    }
}

