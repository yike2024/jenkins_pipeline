pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }
    stages {
        stage('拉取测试脚本') {
            steps {
                checkout scm
            }
        }
        stage('串口自动化测试') {
            steps {
                sh '''
                    command -v sshpass >/dev/null 2>&1 || \
                        (apt-get update -qq && apt-get install -y -qq sshpass) || \
                        (yum install -y sshpass) || true
                    python3 -m pytest tests/ -v -s \
                        --junitxml=results.xml \
                        --html=report.html --self-contained-html \
                        --tb=short
                '''
            }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: 'results.xml,remote_jpeg_results.xml'
            publishHTML(target: [
                reportDir: '.',
                reportFiles: 'report.html',
                reportName: '串口测试报告',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: false
            ])
        }
    }
}

