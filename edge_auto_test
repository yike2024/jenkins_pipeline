pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }
    stages {
        stage('拉取测试脚本') {
            steps {
                checkout scm
            }
        }
        stage('串口自动化测试') {
            steps {
                sh '''
                    python3 -m pytest tests/ -v \
                        --junitxml=results.xml \
                        --tb=short
                '''
            }
        }
    }
    post {
        always {
            junit 'results.xml'   // 不管成功失败都收集报告
        }
    }
}

