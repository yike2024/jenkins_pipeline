pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }
    stages {
        stage('拉取测试脚本') {
            steps {
                checkout scm
            }
        }
        stage('串口自动化测试') {
            steps {
                sh '''
                    python3 -m pytest tests/ -v \
                        --junitxml=results.xml \
                        --html=report.html --self-contained-html \
                        --tb=short
                '''
            }
        }
    }
    post {
        always {
            junit 'results.xml'
            publishHTML(target: [
                reportDir: '.',
                reportFiles: 'report.html',
                reportName: '串口测试报告',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: false
            ])
        }
    }
}

