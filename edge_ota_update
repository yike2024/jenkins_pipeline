pipeline {
    agent any
    parameters {
        string(name: 'BOARD_IP', defaultValue: '', description: 'Board IP, empty = auto via serial')
        string(name: 'FILE_SERVER_IP', defaultValue: '', description: 'File server IP for board scp')
        string(name: 'SDCARD_TGZ', defaultValue: '', description: 'Absolute path of sdcard.tgz on file server')
    }
    environment {
        BOARD_USER = 'linaro'
        BOARD_PASS = 'linaro'
        FILE_USER = 'otascp'
        FILE_PASS = 'otascp'
    }
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 120, unit: 'MINUTES')
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Resolve BOARD_IP') {
            steps {
                script {
                    def tgzPath = params.SDCARD_TGZ?.trim()
                    def fileServer = params.FILE_SERVER_IP?.trim()
                    if (!fileServer) {
                        error('FILE_SERVER_IP required')
                    }
                    if (!tgzPath) {
                        error('SDCARD_TGZ required')
                    }
                    env.SDCARD_TGZ = tgzPath
                    env.FILE_SERVER_IP = fileServer

                    def ip = params.BOARD_IP?.trim()
                    if (!ip) {
                        ip = sh(
                            script: 'python3 tests/get_board_ip.py',
                            returnStdout: true
                        ).trim()
                        if (!ip) {
                            error('failed to get BOARD_IP from serial')
                        }
                    }
                    env.BOARD_IP = ip
                    echo "BOARD_IP=${ip}"
                    echo "FILE_SERVER_IP=${fileServer}"
                    echo "SDCARD_TGZ=${tgzPath}"
                }
            }
        }
        stage('Board scp sdcard.tgz') {
            steps {
                sh '''
                    #!/bin/bash
                    set -e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15 -o ServerAliveInterval=30 -o ServerAliveCountMax=120"
                    sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" \
                        "command -v sshpass >/dev/null || (echo ${BOARD_PASS} | sudo -S -p '' apt-get update -qq && echo ${BOARD_PASS} | sudo -S -p '' apt-get install -y -qq sshpass)"
                    sshpass -p "${BOARD_PASS}" ssh -n ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" \
                        "mkdir -p /data && sshpass -p '${FILE_PASS}' scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null '${FILE_USER}@${FILE_SERVER_IP}:${SDCARD_TGZ}' /data/sdcard.tgz && ls -lh /data/sdcard.tgz"
                '''
            }
        }
        stage('Extract OTA') {
            steps {
                sh '''
                    #!/bin/bash
                    set -e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15"
                    sshpass -p "${BOARD_PASS}" scp ${SSH_OPTS} \
                        scripts/ota_extract.sh \
                        "${BOARD_USER}@${BOARD_IP}:/tmp/ota_extract.sh"
                    sshpass -p "${BOARD_PASS}" ssh -n ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" \
                        "echo '${BOARD_PASS}' | sudo -S -p '' bash /tmp/ota_extract.sh"
                '''
            }
        }
        stage('Run local_update') {
            steps {
                sh '''
                    #!/bin/bash
                    set +e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15 -o ServerAliveInterval=10"
                    sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" \
                        "echo '${BOARD_PASS}' | sudo -S -p '' /data/ota/local_update.sh /data/ota/md5.txt"
                    RC=$?
                    if [ "${RC}" -ne 0 ] && [ "${RC}" -ne 255 ]; then
                        exit "${RC}"
                    fi
                    exit 0
                '''
            }
        }
        stage('Serial wait & bm_version') {
            steps {
                script {
                    def rc = sh(
                        script: 'python3 tests/wait_ota_serial.py 3600 45',
                        returnStatus: true
                    )
                    if (rc != 0) {
                        error('serial wait timeout')
                    }
                    def ip = sh(
                        script: 'test -f board_ip.txt && cat board_ip.txt || true',
                        returnStdout: true
                    ).trim()
                    if (!ip) {
                        error('BOARD_IP missing after OTA')
                    }
                    env.BOARD_IP = ip
                    echo "BOARD_IP=${ip}"
                }
                sh '''
                    #!/bin/bash
                    set +e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10"
                    for i in 1 2 3 4 5; do
                        if sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} \
                            "${BOARD_USER}@${BOARD_IP}" "bash -lc 'hostname; bm_version || true; uname -a; hostname -I'"; then
                            exit 0
                        fi
                        sleep 5
                    done
                    exit 0
                '''
            }
        }
    }
    post {
        success { echo "OK BOARD_IP=${env.BOARD_IP}" }
        failure { echo "FAILED" }
    }
}
