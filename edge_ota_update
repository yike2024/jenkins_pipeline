pipeline {
    agent any
    parameters {
        string(name: 'BOARD_IP', defaultValue: '', description: '目标板子 IP，可留空：留空则通过串口 hostname -I 自动获取')
        string(name: 'FILE_SERVER_IP', defaultValue: '', description: '可选。仅当 Jenkins 本地看不到刷机包、需要远程 scp 时填写')
        string(name: 'SDCARD_TGZ', defaultValue: '', description: '刷机包路径。优先填 Jenkins 容器内路径，如 /dailybuild/ubuntu/xxx/sdcard.tgz；也可填宿主机路径 /media/cvitek/share/open/github/dailybuild/...')
    }
    environment {
        BOARD_USER = 'linaro'
        BOARD_PASS = 'linaro'
        FILE_USER = 'cvitek'
        FILE_PASS = 'cvitek123456'
    }
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 120, unit: 'MINUTES')
    }
    stages {
        stage('拉取脚本') {
            steps {
                checkout scm
            }
        }
        stage('参数检查与获取板子 IP') {
            steps {
                script {
                    def tgzPath = params.SDCARD_TGZ?.trim()
                    if (!tgzPath) {
                        error('请填写 SDCARD_TGZ')
                    }
                    env.SDCARD_TGZ = tgzPath
                    env.FILE_SERVER_IP = params.FILE_SERVER_IP?.trim() ?: ''

                    def ip = params.BOARD_IP?.trim()
                    if (ip) {
                        echo "使用手动填写的 BOARD_IP=${ip}"
                    } else {
                        echo "BOARD_IP 为空，通过串口自动获取..."
                        ip = sh(
                            script: 'python3 tests/get_board_ip.py',
                            returnStdout: true
                        ).trim()
                        if (!ip) {
                            error('串口未能获取到板子 IP')
                        }
                        echo "串口获取到 BOARD_IP=${ip}"
                    }
                    env.BOARD_IP = ip
                }
                sh '''
                    #!/bin/bash
                    set -e
                    command -v sshpass >/dev/null
                    command -v ssh >/dev/null
                    command -v scp >/dev/null
                    echo "BOARD_IP=[${BOARD_IP}]"
                    echo "FILE_SERVER_IP=[${FILE_SERVER_IP}]"
                    echo "SDCARD_TGZ=[${SDCARD_TGZ}]"
                '''
            }
        }
        stage('拷贝刷机包到板子') {
            steps {
                sh '''
                    #!/bin/bash
                    set -e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15 -o ServerAliveInterval=30 -o ServerAliveCountMax=120"
                    LOCAL_TGZ=""

                    # 1) 直接使用参数路径
                    if [ -f "${SDCARD_TGZ}" ]; then
                        LOCAL_TGZ="${SDCARD_TGZ}"
                        echo "使用本地文件: ${LOCAL_TGZ}"
                    fi

                    # 2) 宿主机 dailybuild 路径映射到容器 /dailybuild
                    if [ -z "${LOCAL_TGZ}" ]; then
                        MAPPED=$(echo "${SDCARD_TGZ}" | sed 's|^/media/cvitek/share/open/github/dailybuild|/dailybuild|')
                        if [ "${MAPPED}" != "${SDCARD_TGZ}" ] && [ -f "${MAPPED}" ]; then
                            LOCAL_TGZ="${MAPPED}"
                            echo "使用容器映射路径: ${LOCAL_TGZ}"
                        fi
                    fi

                    # 3) 常见候选路径再试一次
                    if [ -z "${LOCAL_TGZ}" ]; then
                        BASE="$(basename "${SDCARD_TGZ}")"
                        for cand in \
                            "/dailybuild/ubuntu/$(basename "$(dirname "${SDCARD_TGZ}")")/${BASE}" \
                            "/dailybuild/$(basename "$(dirname "${SDCARD_TGZ}")")/${BASE}"
                        do
                            if [ -f "${cand}" ]; then
                                LOCAL_TGZ="${cand}"
                                echo "使用候选本地路径: ${LOCAL_TGZ}"
                                break
                            fi
                        done
                    fi

                    if [ -n "${LOCAL_TGZ}" ]; then
                        ls -lh "${LOCAL_TGZ}"
                        echo "Jenkins 本地 scp -> ${BOARD_USER}@${BOARD_IP}:/data/sdcard.tgz"
                        sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" "mkdir -p /data"
                        sshpass -p "${BOARD_PASS}" scp ${SSH_OPTS} \
                            "${LOCAL_TGZ}" \
                            "${BOARD_USER}@${BOARD_IP}:/data/sdcard.tgz"
                        sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" \
                            "ls -lh /data/sdcard.tgz"
                        echo "本地拷贝成功"
                        exit 0
                    fi

                    echo "Jenkins 本地看不到刷机包，尝试远程拉取..."
                    if [ -z "${FILE_SERVER_IP}" ]; then
                        echo "本地无文件，且未填写 FILE_SERVER_IP"
                        echo "请把 SDCARD_TGZ 改成容器内路径，例如:"
                        echo "  /dailybuild/ubuntu/2026-07-30_003005/sdcard.tgz"
                        echo "可在 Jenkins 容器内执行: ls /dailybuild/ubuntu/"
                        exit 1
                    fi

                    TMP_TGZ="${WORKSPACE}/sdcard.tgz"
                    rm -f "${TMP_TGZ}"
                    sshpass -p "${FILE_PASS}" scp ${SSH_OPTS} \
                        "${FILE_USER}@${FILE_SERVER_IP}:${SDCARD_TGZ}" \
                        "${TMP_TGZ}"
                    ls -lh "${TMP_TGZ}"
                    sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" "mkdir -p /data"
                    sshpass -p "${BOARD_PASS}" scp ${SSH_OPTS} \
                        "${TMP_TGZ}" \
                        "${BOARD_USER}@${BOARD_IP}:/data/sdcard.tgz"
                    sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" \
                        "ls -lh /data/sdcard.tgz"
                    rm -f "${TMP_TGZ}"
                    echo "远程中转拷贝成功"
                '''
            }
        }
        stage('解压并整理 OTA 目录') {
            steps {
                sh '''
                    #!/bin/bash
                    set -e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15"
                    sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" bash -s <<'EOF'
set -e
mkdir -p /data/ota
rm -rf /data/ota/*
echo "解压 /data/sdcard.tgz -> /data/ota"
tar -xzf /data/sdcard.tgz -C /data/ota
if [ -d /data/ota/sdcard ]; then
    echo "检测到 /data/ota/sdcard，移动其中文件到 /data/ota"
    shopt -s dotglob
    mv /data/ota/sdcard/* /data/ota/
    shopt -u dotglob
    rmdir /data/ota/sdcard 2>/dev/null || rm -rf /data/ota/sdcard
fi
test -f /data/ota/local_update.sh || { echo "缺少 /data/ota/local_update.sh"; ls -la /data/ota; exit 1; }
test -f /data/ota/md5.txt || { echo "缺少 /data/ota/md5.txt"; ls -la /data/ota; exit 1; }
chmod +x /data/ota/local_update.sh
echo "OTA 目录内容:"
ls -la /data/ota
EOF
                '''
            }
        }
        stage('执行 OTA 升级') {
            steps {
                sh '''
                    #!/bin/bash
                    set +e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15 -o ServerAliveInterval=10"
                    echo "执行: sudo /data/ota/local_update.sh /data/ota/md5.txt"
                    sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" \
                        "echo '${BOARD_PASS}' | sudo -S -p '' /data/ota/local_update.sh /data/ota/md5.txt"
                    RC=$?
                    echo "local_update.sh 退出码: ${RC}"
                    if [ "${RC}" -ne 0 ] && [ "${RC}" -ne 255 ]; then
                        echo "OTA 脚本执行失败"
                        exit "${RC}"
                    fi
                    exit 0
                '''
            }
        }
        stage('等待板子恢复') {
            steps {
                sh '''
                    #!/bin/bash
                    set +e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5"
                    echo "等待板子 ${BOARD_IP} 重新上线..."
                    for i in $(seq 1 60); do
                        if sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} \
                            "${BOARD_USER}@${BOARD_IP}" "echo OTA_BOARD_ALIVE" 2>/dev/null | grep -q OTA_BOARD_ALIVE; then
                            echo "板子已恢复，第 ${i} 次探测成功"
                            sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} \
                                "${BOARD_USER}@${BOARD_IP}" \
                                "bash -lc 'hostname; bm_version || true; uname -a'"
                            exit 0
                        fi
                        echo "等待中... (${i}/60)"
                        sleep 10
                    done
                    echo "等待超时：板子在约 10 分钟内未恢复 SSH"
                    exit 1
                '''
            }
        }
    }
    post {
        success { echo "OTA 升级流程完成: ${env.BOARD_IP}" }
        failure { echo "OTA 升级失败，请查看 Console Output" }
    }
}
