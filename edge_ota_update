pipeline {
    agent any
    parameters {
        string(name: 'BOARD_IP', defaultValue: '', description: '目标板子 IP，可留空：留空则通过串口 hostname -I 自动获取')
        string(name: 'FILE_SERVER_IP', defaultValue: '', description: '刷机包所在机器 IP（板子从这台机器 scp 拉取）')
        string(name: 'SDCARD_TGZ', defaultValue: '', description: '刷机包在文件服务器上的绝对路径，例如 /media/cvitek/share/open/github/dailybuild/ubuntu/xxx/sdcard.tgz')
    }
    environment {
        BOARD_USER = 'linaro'
        BOARD_PASS = 'linaro'
    }
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 120, unit: 'MINUTES')
    }
    stages {
        stage('拉取脚本') {
            steps {
                checkout scm
            }
        }
        stage('参数检查与获取板子 IP') {
            steps {
                script {
                    if (!params.FILE_SERVER_IP?.trim()) {
                        error('请填写 FILE_SERVER_IP（刷机包所在机器）')
                    }
                    if (!params.SDCARD_TGZ?.trim()) {
                        error('请填写 SDCARD_TGZ（文件服务器上的绝对路径）')
                    }
                    def ip = params.BOARD_IP?.trim()
                    if (ip) {
                        echo "使用手动填写的 BOARD_IP=${ip}"
                    } else {
                        echo "BOARD_IP 为空，通过串口自动获取..."
                        ip = sh(
                            script: 'python3 tests/get_board_ip.py',
                            returnStdout: true
                        ).trim()
                        if (!ip) {
                            error('串口未能获取到板子 IP')
                        }
                        echo "串口获取到 BOARD_IP=${ip}"
                    }
                    env.BOARD_IP = ip
                }
                sh '''
                    #!/bin/bash
                    set -e
                    command -v sshpass >/dev/null
                    command -v ssh >/dev/null
                    echo "BOARD_IP=${BOARD_IP}            # 目标板子"
                    echo "FILE_SERVER_IP=${FILE_SERVER_IP}  # 刷机包所在机器"
                    echo "SDCARD_TGZ=${SDCARD_TGZ}      # 源路径"
                    echo "流程: Jenkins -> SSH 板子 -> 板子 scp ${FILE_SERVER_IP}:${SDCARD_TGZ} -> /data/sdcard.tgz"
                '''
            }
        }
        stage('板子 scp 拉取刷机包') {
            steps {
                sh '''
                    #!/bin/bash
                    set -e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15"
                    echo "在板子 ${BOARD_IP} 上执行 scp 拉取..."
                    sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" bash -s <<EOF
set -e
mkdir -p /data
echo "源: ${BOARD_USER}@${FILE_SERVER_IP}:${SDCARD_TGZ}"
echo "目标: /data/sdcard.tgz"
if command -v sshpass >/dev/null 2>&1; then
    sshpass -p "${BOARD_PASS}" scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        "${BOARD_USER}@${FILE_SERVER_IP}:${SDCARD_TGZ}" /data/sdcard.tgz
else
    echo "板子未安装 sshpass，尝试免密 scp..."
    scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes \
        "${BOARD_USER}@${FILE_SERVER_IP}:${SDCARD_TGZ}" /data/sdcard.tgz
fi
ls -lh /data/sdcard.tgz
EOF
                '''
            }
        }
        stage('解压并整理 OTA 目录') {
            steps {
                sh '''
                    #!/bin/bash
                    set -e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15"
                    sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" bash -s <<'EOF'
set -e
mkdir -p /data/ota
rm -rf /data/ota/*
echo "解压 /data/sdcard.tgz -> /data/ota"
tar -xzf /data/sdcard.tgz -C /data/ota
if [ -d /data/ota/sdcard ]; then
    echo "检测到 /data/ota/sdcard，移动其中文件到 /data/ota"
    shopt -s dotglob
    mv /data/ota/sdcard/* /data/ota/
    shopt -u dotglob
    rmdir /data/ota/sdcard 2>/dev/null || rm -rf /data/ota/sdcard
fi
test -f /data/ota/local_update.sh || { echo "缺少 /data/ota/local_update.sh"; ls -la /data/ota; exit 1; }
test -f /data/ota/md5.txt || { echo "缺少 /data/ota/md5.txt"; ls -la /data/ota; exit 1; }
chmod +x /data/ota/local_update.sh
echo "OTA 目录内容:"
ls -la /data/ota
EOF
                '''
            }
        }
        stage('执行 OTA 升级') {
            steps {
                sh '''
                    #!/bin/bash
                    set +e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=15 -o ServerAliveInterval=10"
                    echo "执行: sudo /data/ota/local_update.sh /data/ota/md5.txt"
                    sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} "${BOARD_USER}@${BOARD_IP}" \
                        "echo '${BOARD_PASS}' | sudo -S -p '' /data/ota/local_update.sh /data/ota/md5.txt"
                    RC=$?
                    echo "local_update.sh 退出码: ${RC}"
                    if [ "${RC}" -ne 0 ] && [ "${RC}" -ne 255 ]; then
                        echo "OTA 脚本执行失败"
                        exit "${RC}"
                    fi
                    exit 0
                '''
            }
        }
        stage('等待板子恢复') {
            steps {
                sh '''
                    #!/bin/bash
                    set +e
                    SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5"
                    echo "等待板子 ${BOARD_IP} 重新上线..."
                    for i in $(seq 1 60); do
                        if sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} \
                            "${BOARD_USER}@${BOARD_IP}" "echo OTA_BOARD_ALIVE" 2>/dev/null | grep -q OTA_BOARD_ALIVE; then
                            echo "板子已恢复，第 ${i} 次探测成功"
                            sshpass -p "${BOARD_PASS}" ssh ${SSH_OPTS} \
                                "${BOARD_USER}@${BOARD_IP}" \
                                "bash -lc 'hostname; bm_version || true; uname -a'"
                            exit 0
                        fi
                        echo "等待中... (${i}/60)"
                        sleep 10
                    done
                    echo "等待超时：板子在约 10 分钟内未恢复 SSH"
                    exit 1
                '''
            }
        }
    }
    post {
        success { echo "OTA 升级流程完成: ${env.BOARD_IP}" }
        failure { echo "OTA 升级失败，请查看 Console Output" }
    }
}
